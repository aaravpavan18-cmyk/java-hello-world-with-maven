pipeline {
    agent {
        label 'maven-docker'
    }

    environment {
        // Securely bind your Nexus credentials from the Jenkins dashboard
        // 'nexus-credentials-id' must match the exact ID you created in the Jenkins UI
        NEXUS_CREDS = credentials('nexus')
    }

    parameters {
        // You manually type the build number here during a failure recovery run
        string(name: 'UPSTREAM_BUILD_NUMBER', defaultValue: 'LAST_SUCCESSFUL', description: 'Enter the upstream build number to retry, or leave as LAST_SUCCESSFUL')
    }

    stages {
        stage('Fetch Artifact') {
            steps {
                script {
                    // Determine which selector to use based on user input
                    def targetSelector = specific(params.UPSTREAM_BUILD_NUMBER)
                    
                    if (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') {
                        targetSelector = lastSuccessfulBuild()
                    }
                }    
                // Copy the specific file from the upstream build job
                copyArtifacts(
                    projectName: 'build-java-maven',
                    selector: targetSelector,
                    filter: 'target/*.jar',
                    fingerprintArtifacts: true
                )
            }
        }
        stage('Publish to Nexus via Plugin') {
            steps {
                nexusArtifactUploader(
                    nexusVersion: 'nexus2',
                    protocol: 'http',
                    nexusUrl: '10.253.41.229:8081/repository',
                    repository: 'maven-builds',
                    credentialsId: 'nexus',
                    groupId: 'org.springframework',
                    version: '0.2.0',
                    artifacts: [
                        [
                            artifactId: 'jb-hello-world-maven',
                            classifier: '',
                            file: 'target/jb-hello-world-maven-0.2.0.jar',
                            type: 'jar'
                        ]
                    ]
                )
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }

    }
}
