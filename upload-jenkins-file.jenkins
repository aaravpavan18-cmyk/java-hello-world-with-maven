pipeline {
    agent {
        label 'maven-docker'
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
    }

    parameters {
        string(name: 'UPSTREAM_BUILD_NUMBER', defaultValue: 'LAST_SUCCESSFUL', description: 'Enter the upstream build number to retry, or leave as LAST_SUCCESSFUL')
    }

    stages {
        stage('Fetch Artifact') {
            steps {
                script {
                    def targetSelector
                    
                    if (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') {
                        targetSelector = lastSuccessful()
                    } else {
                        targetSelector = specific(params.UPSTREAM_BUILD_NUMBER)
                    }
                    
                    // Copies the archived JAR from the upstream workspace
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    // 1. Locate the exact copied JAR file in the target directory dynamically using a wildcard match
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    
                    // Pull the exact filename out of the array context path (e.g. 'target/jb-hello-world-maven-23.jar')
                    def targetFilePath = jarFiles[0].path
                    
                    // 2. Resolve the dynamic version tracking number for Nexus indexing metadata
                    def dynamicVersion = (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') ? "${env.BUILD_NUMBER}" : "${params.UPSTREAM_BUILD_NUMBER}"
                    
                    // 3. Execute authorized push directly to the hosted production repository layout
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '10.253.41.229:8081',
                        repository: 'maven-releases', // Target hosted repository group block bypassed
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${dynamicVersion}", // String interpolation active via double quotes
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${targetFilePath}", // Dynamically points to the resolved file location
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
