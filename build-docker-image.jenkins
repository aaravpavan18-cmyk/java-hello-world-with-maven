pipeline {
    agent {
        label 'sshagent'
    }

    // Requirement 2: Auto-triggers whenever the upstream job finishes successfully
    triggers {
        upstream(upstreamProjects: 'build-java-maven', threshold: hudson.model.Result.SUCCESS)
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
        // Global variables to transfer data between stages dynamically
        TARGET_FILE_PATH     = ''
        UPSTREAM_RUN_NUMBER  = ''
        RESOLVED_TAG         = ''
    }

    parameters {
        // Requirement 3: Manual trigger fallback option via build parameters
        string(name: 'MANUAL_UPSTREAM_BUILD', defaultValue: 'LAST_SUCCESSFUL', description: 'Used ONLY for manual runs. Enter a specific build number or leave as LAST_SUCCESSFUL.')
    }

    stages {
        stage('Resolve Upstream Build Context') {
            steps {
                script {
                    // Safe verification block for Upstream Automation
                    def isUpstreamTriggered = false
                    try {
                        if (currentBuild.upstreamBuilds && currentBuild.upstreamBuilds.size() > 0) {
                            env.UPSTREAM_RUN_NUMBER = currentBuild.upstreamBuilds[0].number.toString()
                            isUpstreamTriggered = true
                            echo "Pipeline auto-triggered by upstream job build #${env.UPSTREAM_RUN_NUMBER}"
                        }
                    } catch (Exception e) {
                        echo "Upstream context check bypassed (Normal behavior for manual pipeline initializations)."
                    }
                    
                    // Manual fallbacks if no active upstream automation event is found
                    if (!isUpstreamTriggered) {
                        if (params.MANUAL_UPSTREAM_BUILD == 'LAST_SUCCESSFUL') {
                            env.UPSTREAM_RUN_NUMBER = 'LAST_SUCCESSFUL'
                            echo "Manual execution set to target the LAST_SUCCESSFUL upstream build."
                        } else {
                            // Ensure the parameter is stripped of any accidental whitespace
                            env.UPSTREAM_RUN_NUMBER = params.MANUAL_UPSTREAM_BUILD.trim()
                            echo "Manual execution targeting specific upstream build: #${env.UPSTREAM_RUN_NUMBER}"
                        }
                    }
                }
            }
        }

        stage('Fetch Artifact') {
            steps {
                script {
                    // Requirement 1 & 3: Configure selectors dynamically without breaking on null metrics
                    def targetSelector
                    if (env.UPSTREAM_RUN_NUMBER == 'LAST_SUCCESSFUL' || env.UPSTREAM_RUN_NUMBER == '') {
                        targetSelector = lastSuccessful()
                    } else {
                        // Safe conversion now that env.UPSTREAM_RUN_NUMBER is guaranteed to be a valid numeric string
                        targetSelector = specific(env.UPSTREAM_RUN_NUMBER.toInteger())
                    }
                    
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: 'https://github.com'
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    env.TARGET_FILE_PATH = jarFiles[0].path
                    
                    // Requirement 4 & 5: Format the tag properly. If 'LAST_SUCCESSFUL' was evaluated,
                    // we stamp it with the current downstream build sequence so Docker receives a valid tag.
                    def finalDockerTag = env.UPSTREAM_RUN_NUMBER
                    if (finalDockerTag == 'LAST_SUCCESSFUL' || finalDockerTag == '') {
                        finalDockerTag = "${env.BUILD_NUMBER}"
                    }
                    
                    env.RESOLVED_TAG = finalDockerTag
                    
                    // Build image dynamically and inject the tag context straight into the Dockerfile ARG
                    sh "docker build --build-arg APP_VERSION=${env.RESOLVED_TAG} -t SUMAN-JAVA:${env.RESOLVED_TAG} ."                    
                }
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '192.168.0.169:8081',
                        repository: 'maven-releases', 
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${env.RESOLVED_TAG}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
