pipeline {
    agent {
        label 'sshagent'
    }

    // Auto-triggers whenever the upstream job finishes successfully
    triggers {
        upstream(upstreamProjects: 'build-java-maven', threshold: hudson.model.Result.SUCCESS)
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
        // Global storage variables to handle dynamic tracking context across different stages cleanly
        TARGET_FILE_PATH     = ''
        UPSTREAM_RUN_NUMBER  = ''
        RESOLVED_TAG         = ''
    }

    parameters {
        // Aligned parameter naming schema perfectly
        string(name: 'UPSTREAM_BUILD_NUMBER', defaultValue: 'LAST_SUCCESSFUL', description: 'Used for MANUAL runs only. Enter a specific build number or leave as LAST_SUCCESSFUL.')
    }

    stages {
        stage('Resolve Upstream Build Context') {
            steps {
                script {
                    // Sandbox-safe inspection using currentBuild.buildCauses to detect automated triggers
                    def causes = currentBuild.buildCauses
                    def isAutoTriggered = false
                    
                    for (cause in causes) {
                        if (cause.toString().contains("UpstreamCause") || cause.shortDescription.contains("upstream project")) {
                            if (cause.upstreamBuild) {
                                env.UPSTREAM_RUN_NUMBER = cause.upstreamBuild.toString()
                                isAutoTriggered = true
                                break
                            }
                        }
                    }
                    
                    if (isAutoTriggered) {
                        echo "Pipeline auto-triggered by upstream job build #${env.UPSTREAM_RUN_NUMBER}"
                    } else {
                        // Manual run fallback path utilizing aligned parameters block
                        def inputVal = params.UPSTREAM_BUILD_NUMBER ? params.UPSTREAM_BUILD_NUMBER.trim() : 'LAST_SUCCESSFUL'
                        env.UPSTREAM_RUN_NUMBER = inputVal
                        echo "Manual execution handling resolved value: ${env.UPSTREAM_RUN_NUMBER}"
                    }
                }
            }
        }

        stage('Fetch Artifact') {
            steps {
                script {
                    def targetSelector
                    
                    if (env.UPSTREAM_RUN_NUMBER == 'LAST_SUCCESSFUL' || env.UPSTREAM_RUN_NUMBER == 'null' || env.UPSTREAM_RUN_NUMBER == '') {
                        echo "Targeting artifact compilation from: LAST_SUCCESSFUL record copy"
                        targetSelector = lastSuccessful()
                    } else {
                        echo "Targeting artifact compilation from specific build number: ${env.UPSTREAM_RUN_NUMBER}"
                        targetSelector = specific(env.UPSTREAM_RUN_NUMBER.toInteger())
                    }
                    
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: 'https://github.com/aaravpavan18-cmyk/java-hello-world-with-maven.git'
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    env.TARGET_FILE_PATH = jarFiles[0].path
                    
                    // Format docker tags to always yield a unique valid tag tracking number
                    def finalDockerTag = env.UPSTREAM_RUN_NUMBER
                    if (finalDockerTag == 'LAST_SUCCESSFUL' || finalDockerTag == 'null' || finalDockerTag == '') {
                        finalDockerTag = "${env.BUILD_NUMBER}"
                    }
                    
                    env.RESOLVED_TAG = finalDockerTag
                    
                    // Fix: Repo name converted to lowercase "suman-java" to comply with core Docker naming limits
                    sh "docker build --build-arg APP_VERSION=${env.RESOLVED_TAG} -t suman-java:${env.RESOLVED_TAG} ."                    
                }
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '192.168.31.240:8081',
                        repository: 'maven-releases', 
                        username: "${env.NEXUS_CREDS_USR}",
                        password: "${env.NEXUS_CREDS_PSW}",
                        groupId: 'org.springframework',
                        version: "${env.RESOLVED_TAG}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
