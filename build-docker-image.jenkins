pipeline {
    agent {
        label 'sshagent'
    }

    // Requirement 2: Auto-triggers whenever the upstream job finishes successfully
    triggers {
        upstream(upstreamProjects: 'build-java-maven', threshold: hudson.model.Result.SUCCESS)
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
        // Global variables to transfer data between stages dynamically
        TARGET_FILE_PATH     = ''
        UPSTREAM_RUN_NUMBER  = ''
        RESOLVED_TAG         = ''
    }

    parameters {
        // Requirement 3: Manual trigger fallback option via build parameters
        string(name: 'MANUAL_UPSTREAM_BUILD', defaultValue: 'LAST_SUCCESSFUL', description: 'Used ONLY for manual runs. Enter a specific build number or leave as LAST_SUCCESSFUL.')
    }

    stages {
        stage('Resolve Upstream Build Context') {
            steps {
                script {
                    // Requirement 5: Safely read the environment runtime cause list to check for auto-triggers
                    def causes = currentBuild.rawBuild.getCauses()
                    def isAutoTriggered = false
                    
                    for (cause in causes) {
                        if (cause.class.toString().contains("UpstreamCause")) {
                            env.UPSTREAM_RUN_NUMBER = cause.getUpstreamBuild().toString()
                            isAutoTriggered = true
                            break
                        }
                    }
                    
                    if (isAutoTriggered) {
                        echo "Pipeline auto-triggered by upstream job build #${env.UPSTREAM_RUN_NUMBER}"
                    } else {
                        // Manual run: Safely pick up your manual entry parameters
                        def inputVal = params.MANUAL_UPSTREAM_BUILD ? params.MANUAL_UPSTREAM_BUILD.trim() : 'LAST_SUCCESSFUL'
                        env.UPSTREAM_RUN_NUMBER = inputVal
                        echo "Manual execution handling resolved value: ${env.UPSTREAM_RUN_NUMBER}"
                    }
                }
            }
        }

        stage('Fetch Artifact') {
            steps {
                script {
                    // Requirement 1 & 3: Dynamically structure the selector object using the clean string API.
                    // This perfectly bypasses the need for calling unsafe .toInteger() methods.
                    def selectorExpression = ""
                    
                    if (env.UPSTREAM_RUN_NUMBER == 'LAST_SUCCESSFUL' || env.UPSTREAM_RUN_NUMBER == '') {
                        selectorExpression = "<lastSuccessful/>"
                    } else {
                        selectorExpression = "<specific buildNumber='${env.UPSTREAM_RUN_NUMBER}'/>"
                    }
                    
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: buildSelector(selectorExpression),
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: 'https://github.com'
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    env.TARGET_FILE_PATH = jarFiles[0].path
                    
                    // Requirement 4 & 5: Build out tag constraints. If 'LAST_SUCCESSFUL' is configured, 
                    // fall back to the current downstream run sequence so Docker receives a valid tag format.
                    def finalDockerTag = env.UPSTREAM_RUN_NUMBER
                    if (finalDockerTag == 'LAST_SUCCESSFUL' || finalDockerTag == '') {
                        finalDockerTag = "${env.BUILD_NUMBER}"
                    }
                    
                    env.RESOLVED_TAG = finalDockerTag
                    
                    // Build image dynamically and pass version into Dockerfile ARG
                    sh "docker build --build-arg APP_VERSION=${env.RESOLVED_TAG} -t SUMAN-JAVA:${env.RESOLVED_TAG} ."                    
                }
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '192.168.0.169:8081',
                        repository: 'maven-releases', 
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${env.RESOLVED_TAG}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
