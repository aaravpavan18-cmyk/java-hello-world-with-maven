pipeline {
    agent {
        label 'sshagent'
    }

    // Requirement 2: Auto-triggers whenever the upstream job 'build-java-maven' finishes successfully
    triggers {
        upstream(upstreamProjects: 'build-java-maven', threshold: hudson.model.Result.SUCCESS)
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
        // Global variables to transfer data between stages dynamically
        TARGET_FILE_PATH     = ''
        UPSTREAM_RUN_NUMBER  = ''
    }

    parameters {
        // Requirement 3: Manual trigger fallback option via build parameters
        string(name: 'MANUAL_UPSTREAM_BUILD', defaultValue: 'LAST_SUCCESSFUL', description: 'Used ONLY for manual runs. Enter a specific build number or leave as LAST_SUCCESSFUL.')
    }

    stages {
        stage('Resolve Upstream Build Context') {
            steps {
                script {
                    // Requirement 5: Dynamically detects whether the job was triggered automatically or manually
                    def upstreamCause = currentBuild.rawBuild.getCause(hudson.model.Cause$UpstreamCause)
                    
                    if (upstreamCause != null) {
                        // Auto-triggered run: Extract the live build number from the upstream cause
                        env.UPSTREAM_RUN_NUMBER = upstreamCause.getUpstreamBuild().toString()
                        echo "Pipeline auto-triggered by upstream job 'build-java-maven' build #${env.UPSTREAM_RUN_NUMBER}"
                    } else {
                        // Manual run: Fall back to the user parameter input
                        if (params.MANUAL_UPSTREAM_BUILD == 'LAST_SUCCESSFUL') {
                            // Find the actual build number of the last successful job to use as a tag identifier
                            def upstreamJob = Jenkins.get().getItemByFullName('build-java-maven')
                            def lastSuccess = upstreamJob.getLastSuccessfulBuild()
                            if (lastSuccess == null) {
                                error "No successful upstream builds found for 'build-java-maven'!"
                            }
                            env.UPSTREAM_RUN_NUMBER = lastSuccess.getNumber().toString()
                            echo "Manual execution using LAST_SUCCESSFUL upstream build: #${env.UPSTREAM_RUN_NUMBER}"
                        } else {
                            env.UPSTREAM_RUN_NUMBER = params.MANUAL_UPSTREAM_BUILD
                            echo "Manual execution targeting specific upstream build: #${env.UPSTREAM_RUN_NUMBER}"
                        }
                    }
                }
            }
        }

        stage('Fetch Artifact') {
            steps {
                script {
                    // Requirement 1: Downloads the specific artifact from the resolved upstream build number
                    def targetSelector = specific(env.UPSTREAM_RUN_NUMBER.toInteger())
                    
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: 'https://github.com/aaravpavan18-cmyk/java-hello-world-with-maven.git'
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    env.TARGET_FILE_PATH = jarFiles[0].path
                    
                    // Requirement 4 & 5: Build image dynamically using the upstream run number as the tag
                    // Pass the run number into the Dockerfile as an ARG environment metric
                    sh "docker build --build-arg APP_VERSION=${env.UPSTREAM_RUN_NUMBER} -t SUMAN-JAVA:${env.UPSTREAM_RUN_NUMBER} ."                    
                }
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '192.168.0.169:8081',
                        repository: 'maven-releases', 
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${env.UPSTREAM_RUN_NUMBER}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
