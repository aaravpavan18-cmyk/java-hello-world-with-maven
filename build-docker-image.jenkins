pipeline {
    agent {
        label 'sshagent'
    }

    environment {
        NEXUS_CREDS = credentials('nexus')
        // Global holders to safely pass dynamically resolved values between stages
        TARGET_FILE_PATH = ''
        DYNAMIC_VERSION  = ''
    }

    parameters {
        string(name: 'UPSTREAM_BUILD_NUMBER', defaultValue: 'LAST_SUCCESSFUL', description: 'Enter the upstream build number to retry, or leave as LAST_SUCCESSFUL')
        string(name: 'IMAGE_TAG', defaultValue: 'LAST_SUCCESSFUL', description: 'Enter the upstream build number to retry, or leave as LAST_SUCCESSFUL')
    }

    stages {
        stage('Fetch Artifact') {
            steps {
                script {
                    def targetSelector
                    if (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') {
                        targetSelector = lastSuccessful()
                    } else {
                        targetSelector = specific(params.UPSTREAM_BUILD_NUMBER)
                    }
                    
                    // Copies the archived JAR from the upstream workspace
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: 'https://github.com/aaravpavan18-cmyk/java-hello-world-with-maven.git'
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    // 1. Locate the exact copied JAR file in the target directory dynamically
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    
                    // Save values directly to global environment scope so the next stage can see them
                    env.TARGET_FILE_PATH = jarFiles[0].path
                    env.DYNAMIC_VERSION  = (params.IMAGE_TAG == 'LAST_SUCCESSFUL') ? "${env.BUILD_NUMBER}" : "${params.UPSTREAM_BUILD_NUMBER}"
                
                    // Build the Docker image using the Dockerfile in the root workspace
                    sh "docker build -t SUMAN-JAVA:${env.DYNAMIC_VERSION} ."                    
                }
            }
        }
        
        stage('Publish to Nexus via Plugin') {
            steps {
                // Fixed: The entire logic block, including echo, is now securely encapsulated inside the steps scope
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        nexusUrl: '192.168.0.169:8081',
                        repository: 'maven-releases', 
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${env.DYNAMIC_VERSION}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
