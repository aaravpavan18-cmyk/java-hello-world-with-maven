RESOLVED_TAG         = ''
pipeline {
    agent {
        label 'sshagent'
    }

    // Requirement 2: Auto-triggers whenever the upstream job finishes successfully
    triggers {
        upstream(upstreamProjects: 'build-java-maven', threshold: hudson.model.Result.SUCCESS)
    }

    environment {
        // Securely pull credentials map from the Jenkins configuration backend
        NEXUS_CREDS = credentials('nexus')
        // Global storage variables to handle dynamic tracking context across different stages cleanly
        TARGET_FILE_PATH     = ''
        UPSTREAM_RUN_NUMBER  = ''
        
    }

    parameters {
        string(name: 'GIT_REPO_URL', 
               defaultValue: 'https://github.com/aaravpavan18-cmyk/java-hello-world-with-maven.git', 
               description: 'Enter the target Git Repository URL')
        // Define the externalised URL string parameter here
        string(name: 'NEXUS_URL', 
               defaultValue: '192.168.31.240:8081', 
               description: 'Enter the target nexus artifactory URL')
        // Define the externalised URL string parameter here
        choice(name: 'NEXUS_PROTOCOL', 
               choices: ['http', 'https'], 
               description: 'Select protocol for Nexus connection')
        string(name: 'UPSTREAM_BUILD_NUMBER', defaultValue: 'LAST_SUCCESSFUL', description: 'Used for MANUAL runs only. Enter a specific build number or leave as LAST_SUCCESSFUL.')
    }

    stages {    
        stage('Fetch Artifact') {
            steps {
                script {
                    def targetSelector
                    
                    if (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') {
                        targetSelector = lastSuccessful()
                    } else {
                        targetSelector = specific(params.UPSTREAM_BUILD_NUMBER)
                    }
                    
                    // Copies the archived JAR from the upstream workspace
                    copyArtifacts(
                        projectName: 'build-java-maven',
                        selector: targetSelector,
                        filter: 'target/*.jar',
                        fingerprintArtifacts: true
                    )
                }    
            }
        }
        
        stage('Checkout Source') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[
                        credentialsId: 'gitpat', 
                        url: "${params.GIT_REPO_URL}"
                    ]]
                ])
            }
        }

        stage('Docker Build image') {
            steps {
                script {
                    def jarFiles = findFiles(glob: 'target/*.jar')
                    
                    if (jarFiles.length == 0) {
                        error "No JAR file found in target directory! Verify the upstream job archived it successfully."
                    }
                    
                    // Pull the exact filename out of the array context path (e.g. 'target/jb-hello-world-maven-23.jar')
                    def targetFilePath = jarFiles[0].path
                    
                    // 2. Resolve the dynamic version tracking number for Nexus indexing metadata
                    def dynamicVersion = (params.UPSTREAM_BUILD_NUMBER == 'LAST_SUCCESSFUL') ? "${env.BUILD_NUMBER}" : "${params.UPSTREAM_BUILD_NUMBER}"
                    
                    echo "Before tag: ${dynamicVersion}"
                    env.RESOLVED_TAG = dynamicVersion.toString()
                    echo "Tagged: ${env.RESOLVED_TAG}"
                    // Lowercase repository name to satisfy Docker's structural validation constraints
                    sh "docker build --build-arg APP_VERSION=${env.RESOLVED_TAG} -t suman-java:${env.RESOLVED_TAG} ."                    
                }
            }
        } 
        
        stage('Publish to Nexus via Plugin') {
            steps {
                script {
                    nexusArtifactUploader(
                        nexusVersion: 'nexus3',
                        protocol: "${params.NEXUS_PROTOCOL}",
                        nexusUrl: "${params.NEXUS_URL}",
                        repository: 'maven-releases', 
                        credentialsId: 'nexus',
                        groupId: 'org.springframework',
                        version: "${env.RESOLVED_TAG}", 
                        artifacts: [
                            [
                                artifactId: 'jb-hello-world-maven',
                                classifier: '',
                                file: "${env.TARGET_FILE_PATH}", 
                                type: 'jar'
                            ]
                        ]
                    )
                }
                echo "Artifact successfully published to Nexus via Jenkins Plugin!"
            }
        }
    }
}
